generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Page {
  id    Int    @id @default(autoincrement())
  title String @unique

  mainBanner   mainbanner?
  whoWeAre     whoweare?
  mission      ourmission?
  groupMission groupmission?

  homeTeamMembers hometeammember[]
  services        ourservices[]

  aboutUsBanner     aboutusbanner?
  groupHistory      grouphistory?
  strategicPresence strategicpresence?

  theExpansion        theexpansion[]
  ourValues           ourvalues[]
  singaporeLeadership singaporeleadership[]
  strategicObjectives strategicobjectives[]
  contactUs           contactus[]

  ourPartnerMainBanner    ourpartnermainbanner?
  ourPartnerBankPartners  ourpartnerbankpartners?
  ourPartnerOtherPartners ourpartnerotherpartners?
}

model User {
  id            Int      @id @default(autoincrement())
  name          String
  email         String   @unique
  password      String
  role          String   @default("USER")
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  emailVerificationOtp emailverificationotp?
  passwordResetOtp     passwordresetotp?

  @@index([name])
}

model emailverificationotp {
  id        Int      @id @default(autoincrement())
  otpHash   String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model passwordresetotp {
  id         Int       @id @default(autoincrement())
  otpHash    String
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model homefooter {
  id          Int    @id @default(1)
  title       String
  description String
  imageURL    String
}

model navigationbar {
  id       Int    @id @default(1)
  imageURL String
  button   String
}

model mainbanner {
  id          Int     @id @default(autoincrement())
  title       String
  description String?
  imageURL    String

  pageId Int  @unique
  page   Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model whoweare {
  id          Int    @id @default(autoincrement())
  title       String
  description String
  imageURL    String
  button      String

  pageId Int  @unique
  page   Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model ourmission {
  id          Int    @id @default(autoincrement())
  title       String
  description String
  imageURL    String

  pageId Int  @unique
  page   Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model groupmission {
  id          Int    @id @default(autoincrement())
  title       String
  description String
  imageURL    String

  pageId Int  @unique
  page   Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model ourservices {
  id          Int    @id @default(autoincrement())
  title       String
  description String
  imageURL    String

  pageId Int
  page   Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, title])
  @@index([pageId, id])
}

model hometeammember {
  id          Int    @id @default(autoincrement())
  title       String
  description String
  imageURL    String

  pageId Int
  page   Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, title])
  @@index([pageId, id])
}

model aboutusbanner {
  id          Int     @id @default(autoincrement())
  title       String
  description String?
  imageURL    String

  pageId Int  @unique
  page   Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model grouphistory {
  id          Int    @id @default(autoincrement())
  title       String
  description String @db.Text
  imageURL    String

  pageId Int  @unique
  page   Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model strategicpresence {
  id          Int    @id @default(autoincrement())
  title       String
  description String @db.Text
  imageURL    String

  pageId Int  @unique
  page   Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model theexpansion {
  id          Int     @id @default(autoincrement())
  title       String
  description String  @db.Text
  imageURL    String?

  pageId Int
  page   Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, title])
  @@index([pageId, id])
}

model ourvalues {
  id          Int     @id @default(autoincrement())
  title       String
  description String? @db.Text

  pageId Int
  page   Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, title])
  @@index([pageId, id])
}

model singaporeleadership {
  id          Int    @id @default(autoincrement())
  title       String
  description String @db.Text
  imageURL    String

  pageId Int
  page   Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, title])
  @@index([pageId, id])
}

model strategicobjectives {
  id          Int    @id @default(autoincrement())
  title       String
  description String @db.Text
  imageURL    String

  pageId Int
  page   Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, title])
  @@index([pageId, id])
}

model contactus {
  id          Int     @id @default(autoincrement())
  title       String
  description String? @db.Text
  imageURL    String?

  pageId Int
  page   Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, title])
  @@index([pageId, id])
}

model ourpartnermainbanner {
  id          Int     @id @default(autoincrement())
  title       String
  description String? @db.Text
  imageURL    String

  pageId Int  @unique
  page   Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model ourpartnerbankpartners {
  id     Int                          @id @default(autoincrement())
  title  String
  images ourpartnerbankpartnerimage[]

  pageId Int  @unique
  page   Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model ourpartnerbankpartnerimage {
  id       Int    @id @default(autoincrement())
  imageURL String

  sectionId Int
  section   ourpartnerbankpartners @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId, id])
}

model ourpartnerotherpartners {
  id     Int                           @id @default(autoincrement())
  title  String
  images ourpartnerotherpartnerimage[]

  pageId Int  @unique
  page   Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model ourpartnerotherpartnerimage {
  id       Int    @id @default(autoincrement())
  imageURL String

  sectionId Int
  section   ourpartnerotherpartners @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId, id])
}
